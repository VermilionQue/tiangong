# This file is documentation, not automatically loaded. Export variables before starting.
# Use an absolute path OUTSIDE this repository and cloud-sync folders.
# TIANGONG_STATE_DIR=/absolute/path/to/tiangong-state
TIANGONG_ADMIN_USERNAME=admin
# TIANGONG_BACKUP_DIR=/absolute/path/to/tiangong-backups
# For a mounted external drive or NAS, require the actual mount point:
# TIANGONG_BACKUP_MOUNT=/mnt/family-backup
# Optional Apple Health import folder (files stay local):
# TIANGONG_HEALTH_IMPORT_DIR=/absolute/path/to/apple-health
# Optional AI integration. Leave unset for records and local nutrition estimates.
# TIANGONG_OPENCLAW_BIN=/absolute/path/to/openclaw
# TIANGONG_OPENCLAW_AGENT=main
